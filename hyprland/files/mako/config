# Mako notification daemon configuration

# Auto-dismiss notifications after 2 seconds
default-timeout=2000

# Appearance
font=Fira Code 10
background-color=#2e3440
text-color=#d8dee9
border-color=#88c0d0
border-size=2
border-radius=5

# Position
anchor=top-right
margin=10

# Behavior
sort=-time
layer=overlay
