// -*- mode: jsonc -*-
{
    "height": 24,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "battery",
        "clock",
        "tray"
    ],

    // Module configurations
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 50
    },
    "hyprland/submap": {
        "format": "Mode: {}",
        "tooltip": false
    },

    "clock": {
        "timezone": "America/Indiana/Indianapolis",
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": "RAM {used:0.1f}G",
        "tooltip-format": "Memory: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C",
        "format-critical": "HOT {temperatureC}°C",
        "tooltip-format": "Temperature: {temperatureC}°C"
    },

    "backlight": {
        "format": "Brightness {percent}%",
        "tooltip-format": "Screen brightness: {percent}%"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "Battery {capacity}%",
        "format-full": "Battery Full",
        "format-charging": "Charging {capacity}%",
        "format-plugged": "Plugged {capacity}%",
        "tooltip-format": "{capacity}% - {timeTo}"
    },

    "network": {
        "format-wifi": "WiFi {essid}",
        "format-ethernet": "Ethernet",
        "format-disconnected": "No Network",
        "tooltip-format": "{ifname}: {ipaddr}\nSignal: {signalStrength}%",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nmtui"
    },

    "pulseaudio": {
        "format": "Vol {volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol",
        "tooltip-format": "Volume: {volume}%\nClick to open audio settings"
    },

    "tray": {
        "spacing": 10
    }
}
